# ===========================================================================
# ZAMO Medical Platform — Environment Configuration Template
#
# Copy to .env and fill in real values. NEVER commit a real .env file.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================================================================

NODE_ENV=development

# --- Server ---
PORT=3000
APP_BASE_URL=http://localhost:3000

# --- Database (DEC-003: PostgreSQL) ---
DATABASE_URL=postgresql://zamo:zamo@localhost:5432/zamo_dev

# --- Auto Migration ---
# Set to "true" to automatically apply pending migrations on startup
AUTO_MIGRATE=false

# --- Secrets: minimum 32 characters ---
SESSION_SECRET=replace-me-with-a-32-char-minimum-random-value
OTP_PEPPER=replace-me-with-a-32-char-minimum-random-value

# --- Session lifetimes in minutes (A-47: sensitive sessions expire sooner) ---
SESSION_TTL_PATIENT_MIN=10080
SESSION_TTL_STAFF_MIN=480
SESSION_TTL_ADMIN_MIN=30

# --- OTP policy (A-33) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_MAX_REQUESTS_PER_WINDOW=5

# --- Notifications ---
# memory | console | provider
# NOTE: the real WhatsApp/SMS provider is NOT decided yet (OQ-032).
# Everything runs behind NotificationPort (DEC-009) until it is.
NOTIFICATION_ADAPTER=memory

# --- LLM / Smart Agent (B-09: OpenAI initial provider) ---
# mock | openai
# Uses LlmPort abstraction (DEC-009). 'mock' for development/testing.
LLM_ADAPTER=mock
# Required when LLM_ADAPTER=openai
# OPENAI_API_KEY=sk-...
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_COMPLEX=gpt-4o
OPENAI_MONTHLY_CAP_USD=500

# --- Feature Flags ---
# Set to "true" to allow starting with mock notification/LLM providers in production.
# Remove once real providers are configured.
ALLOW_MOCK_PROVIDERS=false
